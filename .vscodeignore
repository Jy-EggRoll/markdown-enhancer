# 默认排除列表
.vscode/
.vscode-test/
src/
out/
node_modules/
.gitignore
**/tsconfig.json
**/eslint.config.mjs
**/*.ts
esbuild.js

# 排除演示 md 文档（readme-img/ 不能排除：Marketplace 展示 README 时同样需要这些图片）
demo.md

# 排除工作区文件
**/*.code-workspace

# 排除工作流等文件
.github/

# 排除发布流程在仓库根目录产生的中间文件（publish.yml 的 Extract CHANGELOG 步骤）
changelog_section.md

# 排除 lock 文件
pnpm-lock.yaml

# 排除维护者内部文档与工作区文件
AGENTS.md
RELEASE.md
pnpm-workspace.yaml
scripts/

# 排除格式化配置
.prettierignore